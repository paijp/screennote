<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1F3A5F</color>
    <color name="pdf_page_backdrop">#2B2B2B</color>

    <!-- The chrome around the page paints from these, never from theme attributes that a parent
         theme or a view's own theme overlay could resolve differently. windowBackground in
         particular is resolved before theme attributes are available. -->
    <color name="surface">#FFFBFE</color>
    <color name="on_surface">#1C1B1F</color>
    <color name="on_surface_variant">#49454F</color>

    <!-- Deliberately not overridden in values-night. This marks "something other than you is
         driving this page", and a status signal that changes colour with the theme is one the
         user has to think about before reading. -->
    <color name="agent_control">#E8710A</color>
</resources>
